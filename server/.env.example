# Backend Environment Variables (Add these to Render or Railway)

# Port Configuration
PORT=8080

# Razorpay Keys (Matches your frontend test/live key)
RAZORPAY_KEY_ID=rzp_test_your_test_key_here
RAZORPAY_KEY_SECRET=your_test_secret_here

# Firebase Admin Configuration
# Note: You need to download your service account JSON file from Firebase Console
# and paste its ENTIRE contents here in one line (minify it or paste as stringified JSON)
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'
