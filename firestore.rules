rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check admin role
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check delivery role
    function isDelivery() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery';
    }

    // Hero Section: Anyone can read, only admin can write
    match /hero_section/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Food Items: Anyone can read, only admin can write
    match /food_items/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Users: Users can read/write own doc. Admins can read all users.
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Carts: Users can read and write their own cart
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Delivery Partners whitelist: Admin can write, anyone authenticated can read
    match /delivery_partners/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Coupons: Anyone can read active coupons. Only admin can write.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Orders: Users can create & read own orders. Admin & Delivery can read/update all.
    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isDelivery()
      );
      allow update: if request.auth != null && (
        isAdmin() ||
        isDelivery() ||
        resource.data.userId == request.auth.uid
      );
    }

    // Default fallback — deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
